<% content_for :title, "#{@recipe.title} · Pantry" %>
<%= link_to "← All recipes", root_path, class: "inline-block rounded py-2 text-sm font-semibold underline-offset-4 hover:underline" %>
<article class="mt-6">
  <header class="mb-10 max-w-3xl">
    <h1 class="font-editorial text-4xl leading-tight wrap-anywhere sm:text-5xl"><%= @recipe.title %></h1>
    <% if @recipe.description.present? %>
      <p class="mt-5 leading-relaxed whitespace-pre-wrap wrap-anywhere text-muted"><%= @recipe.description %></p>
    <% end %>
  </header>
  <div class="grid gap-10 md:grid-cols-5 md:gap-12">
    <section aria-labelledby="ingredients-heading" class="min-w-0 rounded-2xl bg-wash p-6 md:col-span-2">
      <h2 id="ingredients-heading" class="font-editorial text-3xl">Ingredients</h2>
      <% @recipe.ingredient_sections.each do |section| %>
        <section class="mt-7">
          <h3 class="font-semibold wrap-anywhere"><%= section.name %></h3>
          <ul class="mt-3 divide-y divide-line">
            <% section.recipe_ingredients.each do |ingredient| %>
              <li class="flex flex-wrap justify-between gap-x-4 gap-y-1 py-3">
                <span class="min-w-0 wrap-anywhere"><%= ingredient.name %></span>
                <% if ingredient_amount(ingredient).present? %>
                  <span class="wrap-anywhere text-muted"><%= ingredient_amount(ingredient) %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </section>
    <section aria-labelledby="steps-heading" class="min-w-0 md:col-span-3">
      <h2 id="steps-heading" class="font-editorial text-3xl">Preparation</h2>
      <ol class="mt-6 list-decimal space-y-6 pl-6 marker:font-semibold marker:text-leaf">
        <% @recipe.recipe_steps.each do |step| %>
          <li class="pl-2 leading-relaxed whitespace-pre-wrap wrap-anywhere"><%= step.instruction %></li>
        <% end %>
      </ol>
    </section>
  </div>
</article>
