<% content_for :title, "Recipes · Pantry" %>
<div class="mb-10 flex flex-wrap items-end justify-between gap-5">
  <div>
    <p class="mb-3 text-xs font-semibold tracking-widest text-muted uppercase">Your recipe collection</p>
    <h1 class="font-editorial text-4xl sm:text-5xl">Good food, kept close.</h1>
    <p class="mt-4 text-muted">A place for the recipes you’ll come back to.</p>
  </div>
  <%= link_to "New recipe", new_recipe_path, class: "inline-flex min-h-11 items-center rounded-lg bg-leaf px-5 py-3 font-semibold text-white hover:bg-leaf-dark" %>
</div>

<% if @recipes.empty? %>
  <section class="rounded-2xl border border-dashed border-line px-6 py-16 text-center sm:py-24">
    <h2 class="font-editorial text-3xl">Your first recipe starts here</h2>
    <p class="mx-auto mt-4 max-w-sm leading-relaxed text-muted">Save the ingredients and steps for something you love to make.</p>
  </section>
<% else %>
  <ul class="grid gap-5 sm:grid-cols-2">
    <% @recipes.each do |recipe| %>
      <li class="min-w-0">
        <%= link_to recipe, class: "block h-full rounded-xl border border-line bg-white p-6 transition-colors hover:border-leaf hover:bg-wash" do %>
          <h2 class="font-editorial text-2xl wrap-anywhere"><%= recipe.title %></h2>
          <% if recipe.description.present? %>
            <p class="mt-3 line-clamp-3 leading-relaxed wrap-anywhere text-muted"><%= recipe.description %></p>
          <% end %>
          <p class="mt-6 text-sm font-semibold">View recipe <span aria-hidden="true">↗</span></p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
